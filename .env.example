# Envoi des demandes de devis (formulaire du configurateur).
# Copier ce fichier en .env.local pour le developpement, et renseigner les
# memes variables dans Vercel > Settings > Environment Variables pour la prod.

# Serveur SMTP de la boite devis@lappart98.com (MX Plan OVH)
SMTP_HOST=ssl0.ovh.net
# 465 : port annonce par la zone DNS OVH (_submission._tcp) et le seul qui
# accepte l'authentification. En 587, OVH repond 535 Authentication failed.
# Le code passe automatiquement en TLS direct quand le port vaut 465.
SMTP_PORT=465
SMTP_USER=devis@lappart98.com
# Mot de passe d'application, pas le mot de passe du compte
SMTP_PASS=

# Expediteur affiche dans le mail (doit etre autorise par le serveur SMTP)
SMTP_FROM="Site L'Appart 98 <devis@lappart98.com>"

# Destinataire des demandes de devis. Par defaut, SMTP_USER.
DEVIS_TO=contact@lappart98.fr,lappart98@gmail.com
